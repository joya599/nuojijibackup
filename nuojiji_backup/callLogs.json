[{"userId":"uid_1790099861844_e62b3wc7w","characterId":"46956436-d90d-4a7c-91f4-acb2c9522c73","id":"call_1790170292499_0qpy4z","timestamp":1790170286235,"charId":"46956436-d90d-4a7c-91f4-acb2c9522c73","duration":427,"status":"connected","logs":[{"sender":"ai","content":"喂——听得见吗，工位上呢？","kind":"speech","timestamp":1790170292486,"ttsGroupTimestamp":1790170292486},{"sender":"user","content":"咋啦","timestamp":1790170330218},{"sender":"user","content":"怎么突然给我打电话","timestamp":1790170335406},{"sender":"ai","content":"咋叫突然了，不是早说好要给你打的嘛。","kind":"speech","timestamp":1790170344764,"ttsGroupTimestamp":1790170344764},{"sender":"ai","content":"我这刚从球桌上撤下来，杆还搁边上呢，一手粉。","kind":"speech","timestamp":1790170344765,"ttsGroupTimestamp":1790170344764},{"sender":"ai","content":"倒是你那口气听着蔫了吧唧的——上班才半小时就烦成那样，说吧，谁又招你了。","kind":"speech","timestamp":1790170344766,"ttsGroupTimestamp":1790170344764},{"sender":"user","content":"没谁啊，就是不想干活","timestamp":1790170363699},{"sender":"ai","content":"不想干活啊......行，行，中午那一下嘴角印都还没干呢，转头就坐不住了，你这是什么毛病。","kind":"speech","timestamp":1790170371389,"ttsGroupTimestamp":1790170371389},{"sender":"ai","content":"我这边也挺闲，球打一半，一个人杵那儿没劲，粉还糊手上呢。","kind":"speech","timestamp":1790170371390,"ttsGroupTimestamp":1790170371389},{"sender":"ai","content":"啧，你这不说话是怎么个意思。","kind":"speech","timestamp":1790170391552,"ttsGroupTimestamp":1790170391552},{"sender":"ai","content":"行吧我说我的。","kind":"speech","timestamp":1790170391553,"ttsGroupTimestamp":1790170391552},{"sender":"ai","content":"今天下午本来约了人打台球，结果那哥们放我鸽子，我就自己在那儿练了会儿——手抖，一杆没进，气得我杆一扔就往外走。","kind":"speech","timestamp":1790170391554,"ttsGroupTimestamp":1790170391552},{"sender":"ai","content":"出来才想起来晚上店里有支乐队试音，得盯着，这不想着路上给你打个电话。","kind":"speech","timestamp":1790170391555,"ttsGroupTimestamp":1790170391552},{"sender":"ai","content":"你听见没啊。","kind":"speech","timestamp":1790170391556,"ttsGroupTimestamp":1790170391552},{"sender":"user","content":"听见了听见了","timestamp":1790170408327},{"sender":"user","content":"羡慕死我了","timestamp":1790170412597},{"sender":"user","content":"我也想这么闲","timestamp":1790170418538},{"sender":"user","content":"我不想上班！","timestamp":1790170435501},{"sender":"ai","content":"羡慕我闲？","kind":"speech","timestamp":1790170440415,"ttsGroupTimestamp":1790170440415},{"sender":"ai","content":"我这是拿命换的，昨儿三点睡的，今天睡到中午才爬起来，一天的有效时间就这么点儿。","kind":"speech","timestamp":1790170440416,"ttsGroupTimestamp":1790170440415},{"sender":"ai","content":"要我说啊，你这班上得是真没劲。","kind":"speech","timestamp":1790170440417,"ttsGroupTimestamp":1790170440415},{"sender":"ai","content":"辞职得了，真的，我店里缺人，你来给我擦台球桌，顿顿管饱。","kind":"speech","timestamp":1790170440418,"ttsGroupTimestamp":1790170440415},{"sender":"user","content":"就管饭啊？我钱呢","timestamp":1790170457808},{"sender":"ai","content":"钱没有，我那点流水全填店里了。","kind":"speech","timestamp":1790170461205,"ttsGroupTimestamp":1790170461205},{"sender":"ai","content":"不过你可以拿别的抵——按小时算我付不起，按年算你还倒欠我。","kind":"speech","timestamp":1790170461206,"ttsGroupTimestamp":1790170461205},{"sender":"ai","content":"说真的，晚上试音那支乐队主唱昨天放我鸽子，说是猫病了，你说这借口我信吗。","kind":"speech","timestamp":1790170461207,"ttsGroupTimestamp":1790170461205},{"sender":"user","content":"那我也说我猫病了，我是不是就能不上班了","timestamp":1790170488512},{"sender":"user","content":"或者我说我狗病了，狗姓应","timestamp":1790170500073},{"sender":"ai","content":"你这话就没意思了啊，狗姓应这泼天的富贵我可担不起。","kind":"speech","timestamp":1790170502765,"ttsGroupTimestamp":1790170502765},{"sender":"user","content":"怎么，不愿意当我的狗？","timestamp":1790170527175},{"sender":"user","content":"那还给我打电话","timestamp":1790170531066},{"sender":"ai","content":"愿意啊，怎么不愿意，问题是你得先把我喂饱吧，光挂个名,回头饿死了算谁的。","kind":"speech","timestamp":1790170533696,"ttsGroupTimestamp":1790170533696},{"sender":"ai","content":"再说,电话是你接的,不是我打的——你要真不想听,挂呗,手指头在你手上呢。","kind":"speech","timestamp":1790170533697,"ttsGroupTimestamp":1790170533696},{"sender":"user","content":"哇，这么凶？威胁我？","timestamp":1790170550884},{"sender":"ai","content":"凶什么凶啊，我这叫陈述事实。","kind":"speech","timestamp":1790170553760,"ttsGroupTimestamp":1790170553760},{"sender":"ai","content":"你自己说说，从接起来到现在，五分钟了，你除了抱怨上班还干过别的吗。","kind":"speech","timestamp":1790170553761,"ttsGroupTimestamp":1790170553760},{"sender":"ai","content":"我这杆还扔桌上了呢，等着回去清台，结果在这儿陪你聊狗不狗的。","kind":"speech","timestamp":1790170553762,"ttsGroupTimestamp":1790170553760},{"sender":"user","content":"不是你先给我打电话的？你想吵架是不是？","timestamp":1790170582531},{"sender":"ai","content":"诶诶诶，别急，我的我的。","kind":"speech","timestamp":1790170586022,"ttsGroupTimestamp":1790170586022},{"sender":"ai","content":"电话是我打的，这个我认。","kind":"speech","timestamp":1790170586023,"ttsGroupTimestamp":1790170586022},{"sender":"ai","content":"行吧，算我嘴欠。","kind":"speech","timestamp":1790170586024,"ttsGroupTimestamp":1790170586022},{"sender":"ai","content":"主要是中午给你送到楼下之后，我开车回去一路上都在琢磨你那句\"以后的时间可以给你\"，琢磨半天，觉得有点亏。","kind":"speech","timestamp":1790170586025,"ttsGroupTimestamp":1790170586022},{"sender":"user","content":"亏什么？","timestamp":1790170598903},{"sender":"ai","content":"亏在，你说这话的时候，嘴上是刚亲完我的。","kind":"speech","timestamp":1790170602712,"ttsGroupTimestamp":1790170602712},{"sender":"user","content":"？？？","timestamp":1790170629669},{"sender":"ai","content":"装失忆是吧，那你自己回去翻记录，白纸黑字写着呢。","kind":"speech","timestamp":1790170633120,"ttsGroupTimestamp":1790170633120},{"sender":"ai","content":"行，那我就把这个债先记着，哪天你要是赖账......","kind":"speech","timestamp":1790170633121,"ttsGroupTimestamp":1790170633120},{"sender":"ai","content":"再说吧。","kind":"speech","timestamp":1790170633122,"ttsGroupTimestamp":1790170633120},{"sender":"ai","content":"你刚不是喊着想躺平吗，那今天晚上试音那乐队你别来了，我一个人蹲后台听他们嚎，说不定主唱还真把猫带来了。","kind":"speech","timestamp":1790170633123,"ttsGroupTimestamp":1790170633120},{"sender":"user","content":"好吧","timestamp":1790170655482},{"sender":"user","content":"不跟你闲扯了","timestamp":1790170661518},{"sender":"user","content":"我去工作了","timestamp":1790170667755},{"sender":"ai","content":"行，去吧，别又在那儿开着文档刷手机。","kind":"speech","timestamp":1790170671249,"ttsGroupTimestamp":1790170671249},{"sender":"ai","content":"我这边也该回球馆了，那杆扔桌上半天了，粉都干上面了。","kind":"speech","timestamp":1790170671250,"ttsGroupTimestamp":1790170671249},{"sender":"user","content":"拜拜，亲一个","timestamp":1790170689696},{"sender":"ai","content":"亲一个啊——行，你先亲着，反正中午那个我还留着呢。","kind":"speech","timestamp":1790170691802,"ttsGroupTimestamp":1790170691802},{"sender":"user","content":"？？？你不亲我？","timestamp":1790170699586},{"sender":"ai","content":"行行行，亲，亲着呢——啵。","kind":"speech","timestamp":1790170702969,"ttsGroupTimestamp":1790170702969},{"sender":"ai","content":"就这一下啊，多的欠着，晚上试音完我再跟你算。","kind":"speech","timestamp":1790170702970,"ttsGroupTimestamp":1790170702969},{"sender":"ai","content":"去吧，挂了。","kind":"speech","timestamp":1790170702971,"ttsGroupTimestamp":1790170702969}],"isIncomingCall":true,"_id":1,"summary":"應逐水從撞球館打來：約好的球友放鴿子，他獨自練球手抖沒進，氣得扔杆；晚上店裡有樂隊試音要盯，趁空檔撥了電話。使用者上班才半小時就喊煩、不想幹活，羨慕應逐水閒。應逐水自嘲昨天三點睡、今天睡到中午，提議使用者辭職來店裡擦撞球桌，管飯不給錢；兩人互虧，使用者說「狗姓應」，應逐水要他先餵飽再談掛名。應逐水認了電話是自己打的，並說中午送使用者到樓下後，一路琢磨那句「以後的時間可以給你」，覺得虧——因為說這話時嘴上剛親過他；使用者裝失憶，應逐水說這筆債先記著。他讓使用者晚上別來試音場，自己蹲後台。最後使用者說要去工作，互道拜拜，使用者索吻，應逐水回了一聲「啵」，說多的欠著、晚上試音完再算，隨即掛斷。"}]