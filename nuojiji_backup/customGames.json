[{"title":"Pixel Alchemist","description":"触摸拖动即可连续涂色的像素画板，12 色调色盘、橡皮、撤销、清空，支持 16×16 与 32×32 两种画布，作品保存在本机存档中随时读取。","category":"实用工具","icon":"🎨","coverColor":"#4C7DF0","htmlContent":"<!DOCTYPE html>\n<html lang=\"zh\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<title>像素画布</title>\n<style>\n*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}\nbody{margin:0;min-height:100vh;background:#14161c;color:#E7EAF3;padding:92px 14px 36px;\n font-family:-apple-system,\"PingFang SC\",sans-serif;text-align:center}\nh1{font-size:17px;margin:4px 0 12px;letter-spacing:1px}\ncanvas{width:100%;max-width:320px;image-rendering:pixelated;background:#fff;border-radius:12px;\n border:1px solid #2b2f3a;touch-action:none}\n.row{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;margin:12px 0}\n.sw{width:26px;height:26px;border-radius:8px;border:2px solid transparent}\n.sw.on{border-color:#fff}\nbutton{padding:8px 14px;border-radius:12px;border:1px solid #2b2f3a;background:#1c2029;color:#E7EAF3;font-size:13px}\nbutton.pri{background:#4C7DF0;border-color:transparent;font-weight:700}\n.hint{font-size:11px;opacity:.5;margin-top:8px;line-height:1.6}\n</style></head><body>\n<h1>PIXEL ALCHEMIST 像素画布</h1>\n<canvas id=\"cv\" width=\"16\" height=\"16\"></canvas>\n<div class=\"row\" id=\"pal\"></div>\n<div class=\"row\">\n <button id=\"grid\">网格 16x16</button>\n <button id=\"erase\">橡皮</button>\n <button id=\"undo\">撤销</button>\n <button id=\"clear\">清空</button>\n <button class=\"pri\" id=\"save\">保存</button>\n <button id=\"load\">读取</button>\n</div>\n<div class=\"hint\">手指拖动即可连续涂色。作品保存在本机存档里，下次打开还在。</div>\n<script>\nvar COLORS=[\"#000000\",\"#ffffff\",\"#e5484d\",\"#f76808\",\"#ffb224\",\"#46a758\",\"#12a594\",\"#3e63dd\",\"#8e4ec6\",\"#e93d82\",\"#8d8d8d\",\"#c2a383\"];\nvar cv=document.getElementById(\"cv\"),ctx=cv.getContext(\"2d\"),N=16,color=COLORS[0],erasing=false;\nvar grid=[],stack=[];\nfunction blank(){var g=[];for(var i=0;i<N*N;i++)g.push(\"#ffffff\");return g;}\nfunction draw(){ctx.clearRect(0,0,N,N);for(var i=0;i<N*N;i++){ctx.fillStyle=grid[i];ctx.fillRect(i%N,Math.floor(i/N),1,1);}}\nfunction setN(n){N=n;cv.width=n;cv.height=n;grid=blank();stack=[];draw();\n document.getElementById(\"grid\").textContent=\"网格 \"+n+\"x\"+n;}\nCOLORS.forEach(function(c,k){var b=document.createElement(\"button\");b.className=\"sw\"+(k===0?\" on\":\"\");\n b.style.background=c;b.onclick=function(){color=c;erasing=false;\n [].forEach.call(document.querySelectorAll(\".sw\"),function(x){x.classList.remove(\"on\")});b.classList.add(\"on\");};\n document.getElementById(\"pal\").appendChild(b);});\nfunction cellFromEvent(e){var r=cv.getBoundingClientRect();var p=e.touches?e.touches[0]:e;\n var x=Math.floor((p.clientX-r.left)/r.width*N),y=Math.floor((p.clientY-r.top)/r.height*N);\n if(x<0||y<0||x>=N||y>=N)return -1;return y*N+x;}\nvar painting=false,dirty=false;\nfunction paint(e){var i=cellFromEvent(e);if(i<0)return;var c=erasing?\"#ffffff\":color;\n if(grid[i]===c)return;if(!dirty){stack.push(grid.slice());if(stack.length>30)stack.shift();dirty=true;}\n grid[i]=c;draw();}\nfunction down(e){e.preventDefault();painting=true;dirty=false;paint(e);}\nfunction move(e){if(!painting)return;e.preventDefault();paint(e);}\nfunction up(){painting=false;}\ncv.addEventListener(\"mousedown\",down);cv.addEventListener(\"mousemove\",move);\nwindow.addEventListener(\"mouseup\",up);\ncv.addEventListener(\"touchstart\",down,{passive:false});cv.addEventListener(\"touchmove\",move,{passive:false});\nwindow.addEventListener(\"touchend\",up);\ndocument.getElementById(\"grid\").onclick=function(){setN(N===16?32:16);};\ndocument.getElementById(\"erase\").onclick=function(){erasing=!erasing;this.textContent=erasing?\"橡皮 [on]\":\"橡皮\";};\ndocument.getElementById(\"undo\").onclick=function(){if(stack.length){grid=stack.pop();draw();}};\ndocument.getElementById(\"clear\").onclick=function(){stack.push(grid.slice());grid=blank();draw();};\ndocument.getElementById(\"save\").onclick=function(){var b=this;\n try{localStorage.setItem(\"pixel_art\",JSON.stringify({n:N,g:grid}));b.textContent=\"已保存\";\n setTimeout(function(){b.textContent=\"保存\";},1200);}catch(e){}};\ndocument.getElementById(\"load\").onclick=function(){try{var v=JSON.parse(localStorage.getItem(\"pixel_art\")||\"null\");\n if(!v)return;setN(v.n);grid=v.g.slice();draw();}catch(e){}};\nsetN(16);\ntry{var v0=JSON.parse(localStorage.getItem(\"pixel_art\")||\"null\");if(v0){setN(v0.n);grid=v0.g.slice();draw();}}catch(e){}\n</script></body></html>","usesAI":false,"builtinAppId":"builtin-app-pixel","entryKind":"app","author":"Retro Byte","installedToHome":false,"requestedPermissions":[],"requestedNet":{"domains":[]},"requestedSlots":[],"chrome":"auto","sourceLocked":false,"permissions":[],"slots":[],"appId":"app_mudxenbwv143","version":"1.0.0","cspMode":"strict","createdAt":1790157251235,"id":1,"htmlRef":null}]