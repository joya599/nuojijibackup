tries","value":[]},{"userId":"__global__","key":"core_4102444800000_enabled","value":"false"},{"userId":"__global__","key":"core_4102444800000_entries","value":[]},{"userId":"__global__","key":"core_46956436-d90d-4a7c-91f4-acb2c9522c73_enabled","value":"false"},{"userId":"__global__","key":"core_46956436-d90d-4a7c-91f4-acb2c9522c73_entries","value":[]},{"userId":"__global__","key":"gen_template_1f625790-0487-40e4-8475-09854d76c472","value":""},{"userId":"__global__","key":"gen_template_4102444800000","value":""},{"userId":"__global__","key":"gen_template_46956436-d90d-4a7c-91f4-acb2c9522c73","value":""},{"userId":"__global__","key":"gen_template_user_default","value":""},{"userId":"__global__","key":"gen_template_user_uid_1790099861844_e62b3wc7w","value":""},{"userId":"__global__","key":"incident_pool_46956436-d90d-4a7c-91f4-acb2c9522c73","value":{"generatedAt":1790170193896,"userId":"uid_1790099861844_e62b3wc7w","startDateKey":"2026-09-24","days":1,"items":[{"id":"inc_1790170193895_0","tier":1,"category":"luck","valence":"good","requires":{"start":660,"end":1260,"busyLevel":["free","light"],"locationKind":"any","weather":[]},"weight":28,"headline":"旧货摊翻出绝版效果器","narration":"下午路过城南一个旧货市场，摊主把一箱落灰的旧设备当废铁卖。应逐水蹲下翻了二十分钟，从最底下摸出一只停产多年的模拟延迟踏板，外壳有划痕，塞上电池灯还亮。他按废铁价付了钱，摊主还搭了根旧线。","effect":{"busyLevel":"free","titleOverride":"旧货市场淘货","note":"三张钞票换一只老踏板"},"aftermath":"踏板被摆进棚里的效果器架，第二天就想拆开看看。","scene":"","choices":[],"tellUser":"maybe","used":false},{"id":"inc_1790170193895_1","tier":1,"category":"mishap","valence":"bad","requires":{"start":780,"end":1080,"busyLevel":["free","light","busy"],"locationKind":"work","weather":[]},"weight":26,"headline":"冰美式洒在调音台上","narration":"棚里收尾混音时，耳机线带翻了手边的冰美式，咖啡顺着台面流进推子缝里。他拆开面板擦了很久，两个推子推起来还是发涩，只能先拿备用台子顶着。","effect":{"busyLevel":"busy","titleOverride":"拆台子擦咖啡","note":"两个推子发涩"},"aftermath":"约了维修师傅上门，报价不便宜。","scene":"","choices":[],"tellUser":"maybe","used":false},{"id":"inc_1790170193895_2","tier":2,"category":"social","valence":"neutral","requires":{"start":1200,"end":30,"busyLevel":["free","light"],"locationKind":"work","weather":[]},"weight":22,"headline":"旧乐队主唱带着小样上门","narration":"晚上九点多，一个三年前合作过的乐队主唱背着琴包推门进来，帽檐压得很低。他没寒暄，把一只贴着胶布的U盘按在吧台上，说想借后场做一场不公开的试听，只叫十来个人。当晚店里没有正式演出，调音台和监听都空着。","effect":{"busyLevel":"light","titleOverride":"临时试听会","note":"U盘按在吧台上"},"aftermath":"试听的口风传出去，陆续有人来问那支乐队的档期。","scene":"晚上九点二十，店门被推开，风先灌进来，随后是三年前合作过的那支乐队的主唱，背着琴包，帽檐压得很低。他把一只贴着胶布的U盘按在吧台上，说想借后场做一场不公开的试听，只叫十来个人。当晚店里没有正式演出，调音台和监听都空着，台上还留着下午试音时没收的话筒线。应逐水把酒杯推过去，让他先把小样放一遍。","choices":[{"label":"借他一晚","outcome":"应逐水把后场小舞台让了出来，只叫了几个熟客当听众，试听一路做到一点多。","aftermath":"那支乐队开始跟他谈下个月的专场档期。","nextDay":null},{"label":"先谈场地费","outcome":"他报了个不低的数字，对方犹豫了几秒还是转了过来，试听照做。","aftermath":"账上多出一笔计划外的收入。","nextDay":null},{"label":"让他改天再来","outcome":"应逐水把U盘收下，说今晚没空，让他等消息。","aftermath":"第二天他在棚里把那几首小样听了两遍。","nextDay":null}],"tellUser":"yes","used":false},{"id":"inc_1790170193895_3","tier":2,"category":"money","valence":"bad","requires":{"start":1320,"end":60,"busyLevel":["free","light"],"locationKind":"work","weather":[]},"weight":20,"headline":"票务后台冒出十几笔异常退款","narration":"凌晨对账时，应逐水发现票务后台多出十几笔退款记录，时间都集中在当天下午四点前后，金额加起来快两千。他调出对应场次的检票记录，那些座位当晚都坐满了人。冰块在杯子里化完之后，他先把屏幕截了图。","effect":{"busyLevel":"light","titleOverride":"核票务退款","note":"十几笔对不上"},"aftermath":"票务平台隔天回了电话，圈里几个同行说自己也中过。","scene":"凌晨十二点四十，店里的灯只剩吧台上方那一排。应逐水把当晚的流水和票务后台并排摊开，手指顺着屏幕往下划，停在十几笔退款记录上——时间都集中在下午四点前后，金额加起来快两千。他翻出对应场次的检票记录，那些座位当晚都坐满了人。冰块在杯里化开的声音停下之后，他把手机翻过来，先截了屏。","choices":[{"label":"先截图留证据","outcome":"他把退款记录和检票记录都导了出来，给票务平台提了工单，然后照常打烊。","aftermath":"平台隔天上午回电，承认是系统重复退款。","nextDay":null},{"label":"凌晨死磕客服","outcome":"他守在吧台把电话打到三点，转了三个人工，最后只拿到一句“会反馈”。","aftermath":"第二天他睡到下午，起来火气不小。","nextDay":{"title":"睡到下午才起","busyLevel":"sleep","span":"morning"}},{"label":"发朋友圈开骂","outcome":"他拍了张后台截图配文阴阳票务平台，圈里几个同行秒回，说自己也中过。","aftermath":"平台当天上午主动打来电话。","nextDay":null}],"tellUser":"maybe","used":false}],"lastRollKey":null,"lastTickVts":1790177089248,"lastAnchor":1790170837261}},{"userId":"__global__","key":"incident_settings"